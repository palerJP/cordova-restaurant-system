# ============================================================
# CordovaEats Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# Keep real credentials out of version control.
# ============================================================

# --- Local development backend API URL ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# For Vercel, set BACKEND_URL to the deployed backend HTTPS origin in the
# frontend project's environment settings. Production browser requests always
# use the frontend's same-origin /api rewrite; do not expose BACKEND_URL.

# --- Google OAuth ---
# Required to enable the real "Continue with Google" button.
# Steps to get this:
#   1. Go to https://console.cloud.google.com
#   2. Create or select a project
#   3. Go to APIs & Services > Credentials
#   4. Click "Create Credentials" > "OAuth 2.0 Client ID"
#   5. Application type: Web application
#   6. Authorized JavaScript origins: http://localhost:3000
#   7. Authorized redirect URIs: http://localhost:3000 (token flow uses popup, not redirect)
#   8. Copy the Client ID below
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- Email Verification Requirement ---
# In development/localhost, set false so users can log in directly without email confirmation.
# For production deployment, set true to require users to verify their email before logging in.
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false

# --- Google Maps API Key ---
# Required for the interactive JavaScript Google Maps view (pins and info windows).
# If omitted, an embedded Google Map fallback is rendered automatically.
# Steps to get this:
#   1. Go to https://console.cloud.google.com
#   2. Select or create your project
#   3. Go to "APIs & Services" > "Library" > enable "Maps JavaScript API"
#   4. Go to "APIs & Services" > "Credentials" > "Create Credentials" > "API Key"
#   5. Restrict the key to your domains (e.g., localhost:3000 and production domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
