# ============================================================
# CordovaEats Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- PostgreSQL Database ---
# Your PostgreSQL connection string. Adjust port if needed.
# PostgreSQL 18 typically runs on 5432; some installs use 5433.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/cordova_restaurants

# --- JWT / Cookie Secrets ---
# Generate strong random strings: `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_me_with_a_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_another_strong_random_secret_32_chars
COOKIE_SECRET=replace_me_with_cookie_secret

# --- JWT Expiry ---
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth ---
# Get these from https://console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
# Add http://localhost:3000 to Authorized JavaScript origins
# Add http://localhost:4000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Email & Account Verification ---
# In development/localhost, set REQUIRE_EMAIL_VERIFICATION=false so users can sign in without receiving email.
# For production deployment, set REQUIRE_EMAIL_VERIFICATION=true to enforce email verification.
REQUIRE_EMAIL_VERIFICATION=false

# Pick ONE email delivery method:
# Option 1: Resend (recommended - free tier 3000 emails/month)
# https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option 2: SMTP (e.g. Gmail, Mailgun, SendGrid)
# For Gmail: enable 2FA and create an App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your_gmail_app_password

# From address shown in emails
EMAIL_FROM=CordovaEats <noreply@cordovaeats.com>

# --- External AI recommendations (optional) ---
# Create an API key in the OpenAI developer platform and keep it only in this backend .env.
# The server uses the model to interpret free-text food preferences and write grounded suggestions.
# If no key is set, the local preference interpreter and ranker continue to work.
# OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=10000

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=debug
