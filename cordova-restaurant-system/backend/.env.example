# ==== Server ====
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# ==== Database ====
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cordova_restaurants
DB_POOL_MAX=10
DB_SSL=false

# ==== JWT ====
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==== Cookies ====
COOKIE_SECRET=replace_with_another_long_random_string
COOKIE_SECURE=false

# ==== Rate limiting ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ==== File uploads ====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ==== Logging ====
LOG_LEVEL=info
