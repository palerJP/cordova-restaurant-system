# Development environment for backend
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Postgres dev DB - match backend default in src/config/env.js
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cordova_restaurants

# JWT / Cookie dev secrets (only for development)
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars
COOKIE_SECRET=dev_cookie_secret_change_me

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Logging / features
LOG_LEVEL=debug
